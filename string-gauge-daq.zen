# PB2/BOOT1 is reused as ADC reset; R64 still guarantees a low boot strap.
MCU_BOOT1 = ADC_SYNC_RST
MCU_HSE_IN = Net("/MCU_HSE_IN")
MCU_HSE_OUT = Net("/MCU_HSE_OUT")
NRST = Net("/NRST")
