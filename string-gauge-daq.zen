PART_MCU_C_HSE1_C(name="SHEET_9F67FFE8_AFE1_52D2_943E_39048D67A506", GND=GND, MCU_HSE_IN=MCU_HSE_IN)

# STM32F412 ADC pins PA0/PA1/PA4/PB0 are FT I/Os: positive injection is not allowed and they are
# not 5V tolerant in analog mode (DS11139 Rev9 Table 9 note 4, Table 14 note 4). A Schottky to
# the 3.3V rail takes the 14.4V signal-wire fault current, (14.4V - 3.6V) / 10kohm = 1.1mA, so the
# pin stays near VDDA + 0.3V (BAT54WS VF <= 0.32V at 1mA) instead of being driven toward 14.4V.
# The clamp returns to V3V3 (the In2 plane) rather than VDDA: VDDA = V3V3 through FB1 (~mV drop),
# so the clamp level is the same, and fault current does not flow through the MCU's VDDA filter.
Rectifier = Module("@stdlib/generics/Rectifier.zen")

for aux_name, aux_net in [("AUX1", AUX1), ("AUX2", AUX2), ("AUX3", AUX3), ("AUX4", AUX4)]:
    Rectifier(
        name=aux_name + "_D_CLAMP",
        package="SOD-323",
        technology="Schottky",
        reverse_voltage="30V",
        forward_current="200mA",
        A=aux_net,
        K=V3V3,
    )

Board(
    name="suspension-load-daq",
    path="eda",
    schematic=True,
    layers=4,
    config=BoardConfig(
        design_rules=DesignRules(
            # JLCPCB 4-layer standard process: 0.1mm track/space, 0.3mm drill / 0.6mm via pad.
            constraints=Constraints(
                copper=Copper(
                    minimum_clearance=0.1,
                    minimum_track_width=0.1,
                    minimum_connection_width=0.0,
                    minimum_annular_width=0.15,
                    minimum_via_diameter=0.6,
                    copper_to_hole_clearance=0.25,
                    copper_to_edge_clearance=0.4,
                ),
                holes=Holes(minimum_through_hole=0.3, hole_to_hole_clearance=0.25),
                uvias=Uvias(minimum_uvia_diameter=0.15, minimum_uvia_hole=0.1),
                silkscreen=Silkscreen(minimum_item_clearance=0.1, minimum_text_height=0.8),
                solder_mask=SolderMask(clearance=0.0, minimum_width=0.0, to_copper_clearance=0.0),
                zones=Zones(minimum_clearance=0.2),
            ),
            predefined_sizes=PredefinedSizes(
                track_widths=[0.15, 0.2, 0.25, 0.3, 0.4, 0.5, 0.8, 1.0],
                via_dimensions=[
                    ViaDimension(diameter=0.6, drill=0.3),
                    ViaDimension(diameter=0.8, drill=0.4),
                ],
            ),
            netclasses=[
                # 0.1mm = JLC 4-layer standard space; needed for 0.5mm-pitch QFN via fan-out.
                # Analog/power copper is routed with wider spacing by design.
                NetClass(
                    name="Default",
                    clearance=0.1,
                    track_width=0.2,
