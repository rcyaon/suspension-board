PWR_BUCK_MODE_SYNC = Net("/PWR_BUCK_MODE_SYNC")
PWR_LDO_3V3_EN = Net("/PWR_LDO_3V3_EN")
# microSD SPI shares SPI1 with the ADC, with a separate active-low chip select.
SD_CLK = ADC_SPI_CLK
SD_CMD = ADC_SPI_MOSI
SD_DAT0 = ADC_SPI_MISO
SD_DAT1 = Net("/SD_DAT1")
SD_DAT2 = Net("/SD_DAT2")
SD_DAT3 = Net("/SD_CS")
SD_DET = Net("/SD_DET")
SHUNT_CAL = Net("/SHUNT_CAL")
SWD_SWCLK = Net("/SWD_SWCLK")
SWD_SWDIO = Net("/SWD_SWDIO")
# Optional SWO is cut; the TC2030 SWO contact is intentionally unconnected.
SWO = NotConnected()
UART_RX = Net("/UART_RX")
UART_TX = Net("/UART_TX")
USB_CC1 = Net("/USB_CC1")
USB_CC2 = Net("/USB_CC2")
USB_D_N = Net("/USB_D_N")
USB_D_P = Net("/USB_D_P")
VBAT_MON = Net("/VBAT_MON")
VBUS_SENSE = Net("/VBUS_SENSE")
# Voltage contracts describe energized rails, not startup/dropout waveforms.
# ADC CAP and MCU VCAP are internal-core decoupling domains, not external supplies.
ADC_CAP = Power()
CANH = Net()
CANL = Net()
CAN_RX = Net()
CAN_TX = Net()
# LT3042: 100uA * 24.9kohm = 2.49V nominal; 98..102uA, 0.1% RSET, +/-2mV offset.
# https://www.analog.com/media/en/technical-documentation/data-sheets/3042fb.pdf, pp.3,14.
EXC = Power(voltage="2.435V to 2.545V")
# V5 minus the R58 1 ohm drop at the 170 mA worst-case excitation load.
EXC_VIN_FILT = Power(voltage="3.6V to 5.25V")
GND = Ground()
IMU_INT1 = Net()
IMU_SPI_CLK = Net()
IMU_SPI_CS = Net()
IMU_SPI_MISO = Net()
IMU_SPI_MOSI = Net()
MCU_VCAP = Power()
PWR_BUCK_VCC = Power(voltage="3.1V to 3.5V")
PWR_V5_ANA = Power(voltage="3.8V to 5.25V")
# Admitted operating range at the protected buck input (TI SNVSCS7 section 6.3).
# Raw vehicle voltage / transient requirements still require system-level confirmation.
PWR_VPROT = Power(voltage="3V to 36V")
# TPS745: 0.55V * (1 + 255kohm / 51kohm) = 3.3V, including divider/reference error.
V3V3 = Power(voltage="3.18V to 3.42V")
V3V3A = Power(voltage="3.234V to 3.366V")
# V5 includes the RB168MM-40 OR-diode drop (about 0.45-0.55V at 0.1-0.3A); it is not an
# ideal 5V regulator output. Minimum is USB VBUS 4.4V less that drop.
V5 = Power(voltage="3.8V to 5.25V")
V5_BUCK = Power(voltage="4.95V to 5.05V")
VBUS = Power(voltage="4.4V to 5.25V")
VDDA = Power(voltage="3.15V to 3.42V")
# Owner requirement: 9-16V normal operation; transient survival is a separate qualification.
VIN_VEH = Power(voltage="9V to 16V")

