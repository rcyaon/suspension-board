GPIO_PA1 = NotConnected()
GPIO_PA10 = NotConnected()
I2C_SCL = Net("/I2C_SCL")
I2C_SDA = Net("/I2C_SDA")
LDO_3V3_PWR_LDO_3V3_FB = Net("/LDO_3V3/PWR_LDO_3V3_FB")
