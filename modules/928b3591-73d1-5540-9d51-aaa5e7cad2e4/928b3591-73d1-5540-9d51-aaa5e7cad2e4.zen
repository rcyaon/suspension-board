ADC_SYNC_RST = io(Net)
V3V3 = io(Power(voltage="2.7V to 3.6V"))

_10K = Module("../../components/10k/10k.zen")

# PB2 is BOOT1 at reset: R64 pulls it low; do not fit this conflicting pull-up.
