CH1_IN_N = io(Net)
CH1_IN_P = io(Net)
CH1_QTR = io(Net)
EXC = io(Power(voltage="0V to 15V"))
GND = io(Ground)

B6B_PH_K_S = Module("../../components/B6B-PH-K-S/B6B-PH-K-S.zen")

B6B_PH_K_S(
    name="J6",
    PIN_1=EXC,
    PIN_2=CH1_IN_P,
    PIN_3=CH1_IN_N,
    PIN_4=GND,
    PIN_5=CH1_QTR,
    PIN_6=GND,
)
