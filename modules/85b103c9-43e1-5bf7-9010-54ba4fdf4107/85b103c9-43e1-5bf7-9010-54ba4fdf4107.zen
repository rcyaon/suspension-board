CH5_IN_N = io(Net)
CH5_IN_P = io(Net)
CH5_QTR = io(Net)
EXC = io(Power(voltage="0V to 15V"))
GND = io(Ground)

B6B_PH_K_S = Module("../../components/B6B-PH-K-S/B6B-PH-K-S.zen")

B6B_PH_K_S(
    name="J10",
    PIN_1=EXC,
    PIN_2=CH5_IN_P,
    PIN_3=CH5_IN_N,
    PIN_4=GND,
    PIN_5=CH5_QTR,
    PIN_6=GND,
)
