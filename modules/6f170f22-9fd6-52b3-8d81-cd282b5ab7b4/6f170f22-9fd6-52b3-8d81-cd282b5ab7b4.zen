B6B_PH_K_S = Module("../../components/B6B-PH-K-S/B6B-PH-K-S.zen")

B6B_PH_K_S(
    name="J9",
    PIN_1=EXC,
    PIN_2=CH4_IN_P,
    PIN_3=CH4_IN_N,
    PIN_4=GND,
    PIN_5=CH4_QTR,
    PIN_6=GND,
)
